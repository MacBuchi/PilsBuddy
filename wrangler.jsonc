{
  // Cloudflare Workers Static Assets – serves dist/ with no server code.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pilsbuddy",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "pilsbuddy.mcbuchi.de", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
